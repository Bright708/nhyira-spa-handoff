# Copy to .env and fill in. Never commit .env, never put these keys in the client.
PORT=4000
# Allowed site origin(s). Comma-separate several, e.g. https://nhyira.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# The "secret" key (sb_secret_...) or the legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Paystack > Settings > API Keys & Webhooks. Use the TEST secret key.
PAYSTACK_SECRET_KEY=sk_test_xxx

# Treatment rooms: how many bookings may overlap at once (default 2).
ROOMS=2

# Only needed for `npm run migrate`. Supabase > Connect > Session pooler URI (with your DB password).
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
